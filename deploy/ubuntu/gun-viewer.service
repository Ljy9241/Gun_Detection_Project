[Unit]
Description=Read-only device records viewer
After=gun-receiver.service
[Service]
User=gun-receiver
Group=gun-receiver
WorkingDirectory=/opt/gun-viewer
ExecStart=/opt/gun-receiver/current/.venv/bin/python -m uvicorn viewer:app --host 127.0.0.1 --port 18001 --workers 1 --no-access-log
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=160M
UMask=0077
[Install]
WantedBy=multi-user.target